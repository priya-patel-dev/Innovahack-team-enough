# ZipPrompt Production Environment Configuration
# Copy this file to .env and configure secrets accordingly.

PORT=8000
ALLOWED_ORIGINS=*
MAX_SESSIONS=5000
MAX_ITEMS_PER_SESSION=500

# LLM Providers (Optional - for live evaluation and recovery validation)
GOOGLE_API_KEY=your_google_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
